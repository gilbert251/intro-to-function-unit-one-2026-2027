import turtle

t = turtle.Turtle()
t.shape('turtle')
t.speed(3)
TURN_ANGLE = 90

def draw_square(side_length):
    for _ in range(4):
        t.forward(side_length)
        t.left(TURN_ANGLE)

        shapes_queue = [
    {"msg": "Drawing a square...", "size": 100, "x": 0, "y": 0},
    {"msg": "Drawing boom shape...", "size": 50, "x": 150, "y": 0}
]
for shape in shapes_queue:
    # Print the custom message
    print(shape["msg"])
     t.penup()
    t.goto(shape["x"], shape["y"])
    t.pendown()
    draw_square(shape["size"])

turtle.done()